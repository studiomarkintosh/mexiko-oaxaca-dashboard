    { id: "s019", phaseId: 2, name: "El Árbol del Tule 🌳",               lat: 17.0469, lng: -96.6361, type: "daytrip", price: { mxn: 20, eur: 1 },  gratis: false, buggyFriendly: true,  googleMapsUrl: "https://maps.google.com/?q=El+Arbol+del+Tule+Oaxaca", tip: "Breitester Baum der Welt (Stammumfang 58m), UNESCO-Kandidat. 9km von Oaxaca, 15min — ideal kombiniert mit Mitla-Tour." },
    { id: "s025", phaseId: 2, name: "San Bartolo Coyotepec 🏺",          lat: 16.9848, lng: -96.7111, type: "daytrip", price: { mxn: 0, eur: 0 },   gratis: true,  buggyFriendly: true,  googleMapsUrl: "https://maps.google.com/?q=San+Bartolo+Coyotepec+Oaxaca", tip: "Dorf der schwarzen Keramik (Barro Negro). Töpferfamilien direkt besuchen, günstigere Preise als in Oaxaca-Stadt." },
    { id: "s026", phaseId: 2, name: "San Martín Tilcajete 🎨",            lat: 16.9667, lng: -96.7500, type: "daytrip", price: { mxn: 0, eur: 0 },   gratis: true,  buggyFriendly: true,  googleMapsUrl: "https://maps.google.com/?q=San+Martin+Tilcajete+Oaxaca", tip: "Alebrije-Dorf (bunte Holzfabelwesen), Familienwerkstätten. Nicht mit Arrazola verwechseln — andere Familien, andere Stile." },
    { id: "s027", phaseId: 2, name: "Sierra Norte — Pueblos Mancomunados", lat: 17.3167, lng: -96.4667, type: "daytrip", price: { mxn: 150, eur: 7 }, gratis: false, buggyFriendly: false, googleMapsUrl: "https://maps.google.com/?q=Pueblos+Mancomunados+Oaxaca", tip: "8 indigene Bergdörfer auf 3.000m, Ökotourismus. Wandern, Vogelbeobachtung. Dez = kühl, klare Luft. 1,5h von Oaxaca." },
    { id: "s018", phaseId: 2, name: "Arrazola — Alebrijes Werkstätten", lat: 17.0057, lng: -96.7733, type: "daytrip", price: { mxn: 0, eur: 0 },  gratis: true,  buggyFriendly: true,  googleMapsUrl: "https://maps.google.com/?q=Arrazola+Oaxaca", tip: "Holzfiguren direkt bei Familien kaufen" },

